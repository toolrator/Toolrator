[TEMPLATE]
# Toolconnector Configuration Example
# Copy this file to .env and configure as needed.

# Pre-configured API key (skips the device login flow if provided).
CONNECTOR_API_KEY=

# Directory for storing credentials (optional).
# Default is OS-dependent, derived from CONNECTOR_PRODUCT_NAME (default:
# `toolconnector`):
# - Windows: %APPDATA%/<productName>
# - macOS:   ~/Library/Application Support/<productName>
# - Linux:   $XDG_CONFIG_HOME/<productName>   (fallback: ~/.config/<productName>)
# CONNECTOR_CONFIG_DIR=

# Base URL of the account/control-plane backend the connector talks to for
# auth (login/2FA / verify-key / connector/config/auto).
# Default: https://toolrator.org (the upstream SaaS — used as the neutral
# fallback so non-technical / remotely-hosted users without toolpanel still
# get the auto flow). Override to point at your own upstream.
CONNECTOR_UPSTREAM_URL=https://toolrator.org

# Product name driving product-derived identifiers: the config-dir subfolder,
# the implicit-default search-engine id (`<productName>-default`), and any
# user-facing string that mentions the product. The auth-management tool
# name itself (`manage_auth`) is fixed and NOT interpolated, so this does
# not change tool names.
# Default: toolconnector
# CONNECTOR_PRODUCT_NAME=toolconnector

# Base URL of a self-hosted toolpanel instance (optional, recommended for
# local use). When set and active, the connector prefers toolpanel over
# CONNECTOR_UPSTREAM_URL for the authoritative search-engine config
# (verify-key + connector/config/auto).
# Default: http://127.0.0.1:7800
TOOLPANEL_URL=http://127.0.0.1:7800

# Toolpanel auto-discovery knob (auto | off)
#   auto (default) — probe TOOLPANEL_URL at boot + on each re-resolve; prefer
#                    toolpanel only when the probe returns 2xx.
#   off            — skip the probe in auto mode: the connector always uses
#                    CONNECTOR_UPSTREAM_URL without probing. NOTE: with
#                    CONNECTOR_SEARCH_CONFIG_MODE=toolpanel the probe still
#                    runs regardless of this setting.
# Default: auto
# TOOLPANEL_DISCOVERY=auto

# Liveness probe path + timeout (optional).
#   TOOLPANEL_PROBE_PATH        — appended to TOOLPANEL_URL (default: /.well-known/toolpanel-alive)
#   TOOLPANEL_PROBE_TIMEOUT_MS  — probe timeout in ms (default: 1500)
# TOOLPANEL_PROBE_PATH=/.well-known/toolpanel-alive
# TOOLPANEL_PROBE_TIMEOUT_MS=1500

# Logging verbosity: debug, info, warn, error
# Default: info
CONNECTOR_LOG_LEVEL=info

# Custom search engine configurations file path (optional).
# CONNECTOR_SEARCH_CONFIG=

# Mode for pulling discovery configurations (auto | file | toolpanel)
#   auto      — prefer toolpanel (if TOOLPANEL_URL set & reachable), else
#               CONNECTOR_UPSTREAM_URL, else local file
#   toolpanel — only use toolpanel (TOOLPANEL_URL must be set & reachable); if
#               toolpanel is unreachable, use the local search-engines.json
#               (never CONNECTOR_UPSTREAM_URL)
#   file      — only use the local search-engines.json (overrides above)
# Default: auto
CONNECTOR_SEARCH_CONFIG_MODE=auto

# Connector version reported to MCP clients (optional).
# Default: derived from package.json
# TOOLCONNECTOR_VERSION=

