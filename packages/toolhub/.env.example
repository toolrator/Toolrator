# MCP Search Engine Config Example
# Copy this file to .env and configure the variables for local dev / production.

# Host/interface to bind: 127.0.0.1 (loopback only, default) or 0.0.0.0 to expose externally
HOST=127.0.0.1

# HTTP server port
PORT=7600

# Bearer token required for admin endpoints (indexing, reindexing, deleting documents)
SEARCH_ADMIN_TOKEN=dev-admin-token

# Search backend to use: "meilisearch" (production) or "memory" (local development / testing)
SEARCH_BACKEND=meilisearch

# MeiliSearch configuration (only required if SEARCH_BACKEND=meilisearch)
MEILI_URL=http://localhost:7700
MEILI_SEARCH_KEY=
MEILI_ADMIN_KEY=
MEILI_INDEX_NAME=mcp_servers

# Pagination limits
SEARCH_MAX_LIMIT=100
SEARCH_DEFAULT_LIMIT=20

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Embedding provider: unset/null (lexical-only search, default - zero memory
# overhead), "local" (ONNX on CPU - RAM scales with
# TOOLHUB_EMBEDDING_BATCH_SIZE; keep it low on memory-constrained machines),
# or "openai-compatible" (any API speaking the OpenAI embeddings protocol:
# OpenAI, OpenRouter, Cloudflare Workers AI, Groq, Mistral, vLLM, Ollama, ...).
# For zero local inference, use openai-compatible with the base URL/key/model below.
TOOLHUB_EMBEDDING_PROVIDER=

# REQUIRED (no default by design) whenever a provider is set above — it bounds
# peak RAM (local ONNX) and API request packing (remote), so pick it deliberately.
# Start at 32; use 8 on memory-constrained hosts (e.g. <=8 GB RAM).
# TOOLHUB_EMBEDDING_BATCH_SIZE=32

# Only required when TOOLHUB_EMBEDDING_PROVIDER=openai-compatible
# Per-provider base URL examples:
#   OpenAI:    https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Cloudflare: https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
#   Groq:      https://api.groq.com/openai/v1
#   Mistral:   https://api.mistral.ai/v1
TOOLHUB_EMBEDDING_BASE_URL=https://api.openai.com/v1
TOOLHUB_EMBEDDING_API_KEY=

# Embedding model (registry entries: text-embedding-3-small (1536),
# text-embedding-3-large (3072), @cf/baai/bge-small-en-v1.5 (384),
# @cf/baai/bge-base-en-v1.5 (768), @cf/baai/bge-large-en-v1.5 (1024),
# @cf/baai/bge-m3 (1024, 32k ctx), @cf/qwen/qwen3-embedding-0.6b (1024, 128k ctx),
# nemotron-3-embed-1b (2048). OpenRouter-style names (e.g.
# openai/text-embedding-3-small, nvidia/nemotron-3-embed-1b:free) resolve too.)
TOOLHUB_EMBEDDING_MODEL=text-embedding-3-small

# Optional: input_type for asymmetric models. Values are model-specific:
#   bge-m3 (Workers AI) / OpenRouter in general: "search_document" / "search_query"
#   nemotron-3-embed-1b (NVIDIA): "passage" / "query"
# Omit for symmetric models like OpenAI's text-embedding-3-* (they reject
# unknown fields).
# TOOLHUB_EMBEDDING_INPUT_TYPE_DOC=search_document
# TOOLHUB_EMBEDDING_INPUT_TYPE_QUERY=search_query

# Optional overrides for the remote provider (custom models):
# TOOLHUB_EMBEDDING_DIMENSIONS=
# TOOLHUB_EMBEDDING_MAX_CHARS=

# Optional: embedding budget + pooling tuning (defaults match the approved design)
# TOOLHUB_EMBEDDING_CHARS_PER_TOKEN=3.5
# TOOLHUB_EMBEDDING_BUDGET_SAFETY_FACTOR=0.95
# TOOLHUB_EMBEDDING_MIN_CHUNK_CHARS=64
# TOOLHUB_EMBEDDING_POOLING_MODE=weighted_mean     # or simple_mean
# TOOLHUB_EMBEDDING_CONCURRENCY=4                  # 2 for 8B-class models
# TOOLHUB_EMBEDDING_RETRIES=3
# TOOLHUB_EMBEDDING_MAX_BATCH_CHARS=100000

# Indexing caps (D3)
# TOOLHUB_MAX_DESCRIPTION_CHARS=4096
# TOOLHUB_MAX_SEMANTIC_CHARS=16000

# Optional: local provider tuning
# TOOLHUB_LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-small
# TOOLHUB_LOCAL_EMBEDDING_DIMENSIONS=384
# TOOLHUB_LOCAL_EMBEDDING_MAX_CHARS=2048

# Optional: pin ONNX threads for the local provider (resource-constrained hosts)
TOOLHUB_ONNX_THREADS=

# Tool index (D7) — index of per-tool documents used for tool-level ranking
# and intent classification. Disable only when the tool surface is not needed.
# TOOLHUB_TOOL_INDEX_ENABLED=true
# TOOLHUB_TOOL_INDEX_NAME=mcp_tools

# Per-server tool indexing budgets (D7)
# TOOLHUB_MAX_TOOLS_EMBEDDED=64
# TOOLHUB_MAX_TOOL_DESC_CHARS=1200
# TOOLHUB_MAX_TOOL_SCHEMA_CHARS=1200

# Search merge weights (RRF + rollup). Tool rollup evidence refines but never
# dominates the direct server ranking (rollup contributions are capped at
# 1/(rrfK+1) of the rank-1 score).
# TOOLHUB_RRF_K=60
# TOOLHUB_DIRECT_SERVER_WEIGHT=0.55
# TOOLHUB_TOOL_ROLLUP_WEIGHT=0.45
# TOOLHUB_SEARCH_SERVER_TOP_K=20
# TOOLHUB_SEARCH_TOOL_TOP_K=50
# TOOLHUB_MAX_TOOL_HITS_RETURNED=10

# Intent classifier (heuristic, server-first). Tool intent fires when the top
# tool beats the competing servers by a margin AND shows an action cue or
# tool-name overlap. When the top server IS the tool's home server the margin
# is measured against the best *other* server with a stricter threshold.
# TOOLHUB_INTENT_ENABLED=true
# TOOLHUB_INTENT_FALLBACK=server
# TOOLHUB_INTENT_TOOL_MIN_SCORE=0.35
# TOOLHUB_INTENT_TOOL_MARGIN=0.05
# TOOLHUB_INTENT_MULTI_TOOL_COUNT=3
# TOOLHUB_INTENT_MULTI_TOOL_TOP_N=10
# TOOLHUB_INTENT_MULTI_TOOL_MIN_SCORE=0.3
