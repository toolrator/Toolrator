# Toolpanel configuration example
# Copy to .env and adjust as needed.

# ── HTTP server ───────────────────────────────────────────────────────────────
# Port for the toolpanel HTTP server.
PORT=7800

# Bind address. Default 127.0.0.1 (localhost-only).
# WARNING: toolpanel has NO authentication. Binding to 0.0.0.0 exposes the panel
# and the toolconnector device-flow/config endpoints to the network.
HOST=127.0.0.1

# Public base URL used to build the device-flow `verification_uri` returned to
# toolconnector. Defaults to http://127.0.0.1:${PORT}.
# TOOLPANEL_PUBLIC_URL=http://localhost:7800

# ── Upstream MCP Search Engine ────────────────────────────────────────────────
# Base URL of your running mcp-search-engine instance.
SEARCH_ENGINE_BASE_URL=http://127.0.0.1:7600
# Admin bearer token (must match SEARCH_ADMIN_TOKEN of mcp-search-engine).
SEARCH_ADMIN_TOKEN=dev-admin-token

# ── Toolconnector integration ─────────────────────────────────────────────────
# Used to advertise an API key in the panel UI when the user wants the connector
# to skip the device-flow. If unset, the panel still serves the device flow and
# verify-key (open mode: any non-empty bearer is accepted).
# Canonical name: CONNECTOR_API_KEY .
# CONNECTOR_API_KEY=

# Toolpanel is paired with toolconnector via TWO env vars on the connector side:
#   TOOLPANEL_URL=http://127.0.0.1:7800
#   CONNECTOR_SEARCH_CONFIG_MODE=auto        # or "toolpanel" to force toolpanel
# See ../../packages/toolconnector/.env.example for the full list.

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory for toolpanel's small JSON state files (search-engines.json,
# device-codes.json, whoami.json). Default: ./toolpanel-config (next to the package).
# TOOLPANEL_CONFIG_DIR=
