{
  "name": "@toolrator/toolpanel",
  "version": "0.2.0",
  "description": "Open-source, self-hostable control panel for toolconnector + Toolhub. Drop-in replacement for the upstream SaaS endpoint.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "control-panel",
    "self-hosted",
    "device-flow",
    "hono",
    "admin-ui",
    "tool-discovery",
    "typescript"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Toolrator <contact@toolrator.org>",
  "homepage": "https://toolrator.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolrator/Toolrator.git",
    "directory": "packages/toolpanel"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/server.js",
  "bin": {
    "toolpanel": "dist/server.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.6.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
