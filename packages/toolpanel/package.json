{
  "name": "@toolrator/toolpanel",
  "version": "0.1.0",
  "description": "Open-source, self-hostable control panel for toolconnector + Toolhub. Drop-in replacement for the upstream SaaS endpoint.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "control-panel",
    "self-hosted",
    "device-flow",
    "hono",
    "admin-ui",
    "tool-discovery",
    "typescript"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Toolrator <contact@toolrator.com>",
  "homepage": "https://toolrator.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolrator/Toolrator.git",
    "directory": "packages/toolpanel"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/server.js",
  "bin": {
    "toolpanel": "dist/server.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "prestart": "npm run build",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.2.0",
    "hono": "^4.6.11",
    "@hono/node-server": "^1.13.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}