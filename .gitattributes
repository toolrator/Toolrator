# Normalize line endings across all text files
* text=auto

# Binary files — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary

# npm lockfiles are always LF
package-lock.json text eol=lf

# YAML / CI files are always LF
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts are always LF
*.sh text eol=lf

# PowerShell scripts — CRLF on Windows, LF elsewhere
*.ps1 text eol=crlf